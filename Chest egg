local function makeBox(placeholder, y, default)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -24, 0, 32)
    box.Position = UDim2.fromOffset(12, y)
    box.BackgroundColor3 = Color3.fromRGB(48, 51, 64)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.PlaceholderColor3 = Color3.fromRGB(190, 190, 200)
    box.PlaceholderText = placeholder
    box.Text = default or ""
    box.TextSize = 14
    box.Font = Enum.Font.Gotham
    box.ClearTextOnFocus = false
    box.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = box
    return box
end

local xBox = makeBox("Destination X", 52, "0")
local yBox = makeBox("Destination Y", 90, "10")
local zBox = makeBox("Destination Z", 128, "0")
local speedBox = makeBox("Walk speed (0-100)", 166, "16")
local tweenBox = makeBox("Tween speed (studs/second)", 204, "50")

local function makeButton(text, y, color)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 32)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = color
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Text = text
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Parent = frame

    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = button
