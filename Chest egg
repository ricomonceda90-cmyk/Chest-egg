local tpButton = makeButton(
    "INSTANT TELEPORT", 244, Color3.fromRGB(65, 115, 220)
)
local tweenButton = makeButton(
    "TWEEN TO POSITION", 282, Color3.fromRGB(125, 80, 200)
)
local speedButton = makeButton(
    "APPLY WALK SPEED", 320, Color3.fromRGB(35, 145, 110)
)
local noclipButton = makeButton(
    "NOCLIP: OFF", 358, Color3.fromRGB(175, 100, 40)
)

local function getDestination()
    local x = tonumber(xBox.Text)
    local y = tonumber(yBox.Text)
    local z = tonumber(zBox.Text)

    if not x or not y or not z then
        return nil
    end

    if math.abs(x) > 100000
        or math.abs(y) > 100000
        or math.abs(z) > 100000 then
        return nil
    end

    return Vector3.new(x, y, z)
end

tpButton.Activated:Connect(function()
    local destination = getDestination()
    if destination then
        remote:FireServer("Teleport", destination)
    end
end)

tweenButton.Activated:Connect(function()
    local destination = getDestination()
    local speed = tonumber(tweenBox.Text)

    if destination and speed and speed > 0 then
        -- The server controls the tween duration.
        -- This button uses the server's default speed.
        remote:FireServer("Tween", destination)
    end
end)

speedButton.Activated:Connect(function()
    local speed = tonumber(speedBox.Text)
    if speed and speed >= 0 and speed <= 100 then
        remote:FireServer("Speed", speed)
    end
end)

-- Client-side noclip for your own Studio game.
local noclip = false
local originalCollision = {}

local function setNoclip(enabled)
    noclip = enabled

    if not enabled then
        for part, oldValue in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = oldValue
            end
        end
        table.clear(originalCollision)
    end

    noclipButton.Text = enabled and "NOCLIP: ON" or "NOCLIP: OFF"
    noclipButton.BackgroundColor3 = enabled
        and Color3.fromRGB(200, 55, 55)
        or Color3.fromRGB(175, 100, 40)
end

noclipButton.Activated:Connect(function()
    setNoclip(not noclip)
end)

local function setupCharacter(character)
    originalCollision = {}

    if noclip then
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                originalCollision[part] = part.CanCollide
                part.CanCollide = false
            end
        end
    end
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then
    setupCharacter(player.Character)
end

-- Keep newly added character parts non-collidable while enabled.
game:GetService("RunService").Stepped:Connect(function()
    if not noclip then return end

    local character = player.Character
    if not character then return end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            if originalCollision[part] == nil then
                originalCollision[part] = part.CanCollide
            end
            part.CanCollide = false
        end
    end
end)

-- Drag the window using its title area.
local dragging = false
local dragStart
local startPosition

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

close.Activated:Connect(function()
    setNoclip(false)
    gui:Destroy()
end)
